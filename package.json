{
  "name": "logroller",
  "version": "2.1.1",
  "description": "Zero-dependency rotating file stream for Node.js — daily/interval/size rotation, gzip archives, retention, timezone-aware, crash-safe resume",
  "license": "MIT",
  "author": "Vinau",
  "homepage": "https://github.com/VinniWin/logroller#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinniWin/logroller.git"
  },
  "bugs": "https://github.com/VinniWin/logroller/issues",
  "keywords": [
    "log",
    "logger",
    "logging",
    "rotate",
    "rotation",
    "rotating-file",
    "rolling",
    "gzip",
    "compress",
    "retention",
    "stream",
    "writable",
    "daily-rotate",
    "logrotate",
    "timezone",
    "utc",
    "pino",
    "pipeline",
    "crash-safe",
    "resilient",
    "zero-dependency"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pino": {
      "import": {
        "types": "./dist/pino.d.ts",
        "default": "./dist/pino.esm.js"
      },
      "require": {
        "types": "./dist/pino.d.cts",
        "default": "./dist/pino.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.14"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rollup -c",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "npm run build && node --test --experimental-strip-types test/rotate.test.ts test/features.test.ts test/fixes.test.ts && node test/smoke.cjs",
    "verify": "npm run typecheck && npm test",
    "prepublishOnly": "npm run verify",
    "release": "npm run verify && npm pack --dry-run",
    "check:types": "npx --yes @arethetypeswrong/cli --pack ."
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^26.4.0",
    "prettier": "^3.4.2",
    "rollup": "^4.28.1",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
